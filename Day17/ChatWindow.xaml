<Window x:Class="Day15.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" Background="#F0F4F8">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Медицинский чат" FontSize="16" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,10" HorizontalAlignment="Center"/>

        <ListBox Grid.Row="1" x:Name="MessagesListBox" Margin="0,0,0,10" Background="White">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="8" CornerRadius="8" Background="#E9EDF2">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" FontSize="11">
                                <Run Text="{Binding FromUserName}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Timestamp, StringFormat='HH:mm'}" Foreground="Gray" FontWeight="Normal"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageTextBox" Grid.Column="0" Padding="8" 
                     TextWrapping="Wrap" MinHeight="60" MaxHeight="100"/>
            <Button Grid.Column="1" Content="Отправить" Width="80" Height="35" 
                    Click="SendButton_Click" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>