<Window x:Class="Day15.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Уведомление" Height="80" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="Manual">

    <Border Background="#2C3E50" CornerRadius="8" Padding="12" Margin="5">
        <StackPanel>
            <TextBlock Text="Уведомление" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,3"/>
            <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" Foreground="White" FontSize="12"/>
        </StackPanel>
    </Border>
</Window>